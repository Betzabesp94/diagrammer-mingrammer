title: Pedidos con eventos
direction: LR
entrypoint: Cliente
production: true

Cliente [icon: aws-users]
Sistema {
  API [icon: aws-apigateway, label: "API de pedidos"]
  Pedidos [icon: aws-lambda, label: "Procesar pedido"]
  Cola [icon: aws-sqs, label: "Cola de pedidos"]
  Tabla [icon: aws-dynamodb, label: "Tabla de pedidos", tag.multi_az: true]
  Usuarios [icon: aws-cognito, label: "Autenticación"]
}

Cliente > API: "HTTPS" [emphasis: true]
API > Usuarios [type: authentication]
API > Pedidos: "invoca" [emphasis: true]
Pedidos > Cola: "publica evento" [type: event, emphasis: true]
Pedidos > Tabla: "escribe" [emphasis: true]
Cola > Pedidos [type: dependency]
