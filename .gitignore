# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Diagramas generados por usuarios (los de referencia viven en diagrams_ref/)
/diagrams_src/*
!/diagrams_src/.gitkeep

# Imágenes generadas
/output/*
!/output/.gitkeep

# Imágenes sueltas en la raíz (si alguien corre un script sin la ruta de salida)
/*.png
/*.svg
/*.pdf

# Archivos intermedios de Graphviz
*.gv
*.dot

# macOS
.DS_Store
